# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Coverage output (just test-coverage writes to bin/)
/coverage.*

# Dependency directories (remove the vendor/ line if you want to check your vendor directory into source control)
vendor/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Project specific binaries
/sofaprobe
/sofa2json
/sofainfo
/bin/

# AI Agents
.claude/

# Test data: third-party reference files are fetched by
# scripts/fetch-testdata.sh and never committed (see testdata/PROVENANCE.md).
# Everything else under testdata/ (PROVENANCE.md, fuzz corpora) is tracked,
# including the synthetic MIT-licensed files in testdata/sofar/ generated by
# scripts/make_sofar_fixtures.py.
/testdata/*.sofa
/testdata/.*.sofa.*
!/testdata/sofar/*.sofa
